 100:middleware/FreeRTOS-Kernel/timers.c **** /* The definition of messages that can be sent and received on the timer queue.
 101:middleware/FreeRTOS-Kernel/timers.c ****  * Two types of message can be queued - messages that manipulate a software timer,
 102:middleware/FreeRTOS-Kernel/timers.c ****  * and messages that request the execution of a non-timer related callback.  The
 103:middleware/FreeRTOS-Kernel/timers.c ****  * two message types are defined in two separate structures, xTimerParametersType
 104:middleware/FreeRTOS-Kernel/timers.c ****  * and xCallbackParametersType respectively. */
 105:middleware/FreeRTOS-Kernel/timers.c ****     typedef struct tmrTimerParameters
 106:middleware/FreeRTOS-Kernel/timers.c ****     {
 107:middleware/FreeRTOS-Kernel/timers.c ****         TickType_t xMessageValue; /**< An optional value used by a subset of commands, for example,
 108:middleware/FreeRTOS-Kernel/timers.c ****         Timer_t * pxTimer;        /**< The timer to which the command will be applied. */
 109:middleware/FreeRTOS-Kernel/timers.c ****     } TimerParameter_t;
 110:middleware/FreeRTOS-Kernel/timers.c **** 
 111:middleware/FreeRTOS-Kernel/timers.c **** 
 112:middleware/FreeRTOS-Kernel/timers.c ****     typedef struct tmrCallbackParameters
 113:middleware/FreeRTOS-Kernel/timers.c ****     {
 114:middleware/FreeRTOS-Kernel/timers.c ****         portTIMER_CALLBACK_ATTRIBUTE
 115:middleware/FreeRTOS-Kernel/timers.c ****         PendedFunction_t pxCallbackFunction; /* << The callback function to execute. */
 116:middleware/FreeRTOS-Kernel/timers.c ****         void * pvParameter1;                 /* << The value that will be used as the callback func
 117:middleware/FreeRTOS-Kernel/timers.c ****         uint32_t ulParameter2;               /* << The value that will be used as the callback func
 118:middleware/FreeRTOS-Kernel/timers.c ****     } CallbackParameters_t;
 119:middleware/FreeRTOS-Kernel/timers.c **** 
 120:middleware/FreeRTOS-Kernel/timers.c **** /* The structure that contains the two message types, along with an identifier
 121:middleware/FreeRTOS-Kernel/timers.c ****  * that is used to determine which message type is valid. */
 122:middleware/FreeRTOS-Kernel/timers.c ****     typedef struct tmrTimerQueueMessage
 123:middleware/FreeRTOS-Kernel/timers.c ****     {

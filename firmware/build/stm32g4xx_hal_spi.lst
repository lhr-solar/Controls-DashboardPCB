  83:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) RxHalfCpltCallback    : SPI Rx Half Completed callback
  84:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) TxRxHalfCpltCallback  : SPI TxRx Half Completed callback
  85:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) ErrorCallback         : SPI Error callback
  86:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) AbortCpltCallback     : SPI Abort callback
  87:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) MspInitCallback       : SPI Msp Init callback

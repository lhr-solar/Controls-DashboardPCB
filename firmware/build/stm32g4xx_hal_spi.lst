  73:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c **** 
  74:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****       (#) The compilation flag USE_HAL_SPI_REGISTER_CALLBACKS when set to 1U
  75:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****           allows the user to configure dynamically the driver callbacks.
  76:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****           Use Functions HAL_SPI_RegisterCallback() to register an interrupt callback.
  77:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c **** 
  78:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****           Function HAL_SPI_RegisterCallback() allows to register following callbacks:
  79:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) TxCpltCallback        : SPI Tx Completed callback
  80:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) RxCpltCallback        : SPI Rx Completed callback
  81:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_spi.c ****             (++) TxRxCpltCallback      : SPI TxRx Completed callback

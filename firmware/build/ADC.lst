 108:bsp/Src/ADC.c **** void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *h) {
 109:bsp/Src/ADC.c ****     /*
 110:bsp/Src/ADC.c ****     Interrupt triggers this callback when the conversion is complete
 111:bsp/Src/ADC.c ****     */ 
 112:bsp/Src/ADC.c ****     BaseType_t higherPriorityTaskWoken = pdFALSE;
 113:bsp/Src/ADC.c ****     QueueHandle_t* q = NULL; // Queue will never be null by the call [placeholder]
 114:bsp/Src/ADC.c ****     int rawVal;
 115:bsp/Src/ADC.c **** 
 116:bsp/Src/ADC.c ****     if (h->Instance == ADC1) q = adc1_q;
 117:bsp/Src/ADC.c ****     #ifdef ADC2
 118:bsp/Src/ADC.c ****     if (h->Instance == ADC2) q = adc2_q;
 119:bsp/Src/ADC.c ****     #endif
 120:bsp/Src/ADC.c ****     #ifdef ADC3
 121:bsp/Src/ADC.c ****     if (h->Instance == ADC3) q = adc3_q;
 122:bsp/Src/ADC.c ****     #endif
 123:bsp/Src/ADC.c **** 
 124:bsp/Src/ADC.c ****     rawVal = HAL_ADC_GetValue(h);
 125:bsp/Src/ADC.c ****     xQueueSendFromISR(*q, &rawVal, &higherPriorityTaskWoken);
 126:bsp/Src/ADC.c **** 
 127:bsp/Src/ADC.c ****     portYIELD_FROM_ISR(higherPriorityTaskWoken);
 128:bsp/Src/ADC.c **** }

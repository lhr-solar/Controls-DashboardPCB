  44:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****   ==============================================================================
  45:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****                       ##### TIMER Generic features #####
  46:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****   ==============================================================================
  47:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****   [..] The Timer features include:
  48:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (#) 16-bit up, down, up/down auto-reload counter.
  49:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (#) 16-bit programmable prescaler allowing dividing (also on the fly) the
  50:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            counter clock frequency either by any factor between 1 and 65536.
  51:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (#) Up to 4 independent channels for:
  52:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Input Capture
  53:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Output Compare
  54:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) PWM generation (Edge and Center-aligned Mode)
  55:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) One-pulse mode output
  56:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (#) Synchronization circuit to control the timer with external signals and to interconnect
  57:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             several timers together.
  58:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (#) Supports incremental encoder for positioning purposes
  59:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c **** 
  60:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             ##### How to use this driver #####
  61:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****   ==============================================================================
  62:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****     [..]
  63:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****      (#) Initialize the TIM low level resources by implementing the following functions
  64:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****          depending on the selected feature:
  65:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Time Base : HAL_TIM_Base_MspInit()
  66:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Input Capture : HAL_TIM_IC_MspInit()
  67:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Output Compare : HAL_TIM_OC_MspInit()
  68:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) PWM generation : HAL_TIM_PWM_MspInit()
  69:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) One-pulse mode output : HAL_TIM_OnePulse_MspInit()
  70:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Encoder mode output : HAL_TIM_Encoder_MspInit()
  71:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c **** 
  72:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****      (#) Initialize the TIM low level resources :
  73:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****         (##) Enable the TIM interface clock using __HAL_RCC_TIMx_CLK_ENABLE();
  74:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****         (##) TIM pins configuration
  75:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             (+++) Enable the clock for the TIM GPIOs using the following function:
  76:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****              __HAL_RCC_GPIOx_CLK_ENABLE();
  77:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             (+++) Configure these TIM pins in Alternate function mode using HAL_GPIO_Init();
  78:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c **** 
  79:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****      (#) The external Clock can be configured, if needed (the default clock is the
  80:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****          internal clock from the APBx), using the following function:
  81:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****          HAL_TIM_ConfigClockSource, the clock configuration should be done before
  82:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****          any start function.
  83:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c **** 
  84:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****      (#) Configure the TIM in the desired functioning mode using one of the
  85:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        Initialization function of this driver:
  86:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (++) HAL_TIM_Base_Init: to use the Timer to generate a simple time base
  87:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (++) HAL_TIM_OC_Init, HAL_TIM_OC_ConfigChannel and optionally HAL_TIMEx_OC_ConfigPulseOnComp
ARM GAS  /tmp/ccpq7Xtk.s 			page 3


  88:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             to use the Timer to generate an Output Compare signal.
  89:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (++) HAL_TIM_PWM_Init and HAL_TIM_PWM_ConfigChannel: to use the Timer to generate a
  90:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             PWM signal.
  91:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (++) HAL_TIM_IC_Init and HAL_TIM_IC_ConfigChannel: to use the Timer to measure an
  92:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             external signal.
  93:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (++) HAL_TIM_OnePulse_Init and HAL_TIM_OnePulse_ConfigChannel: to use the Timer
  94:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****             in One Pulse Mode.
  95:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****        (++) HAL_TIM_Encoder_Init: to use the Timer Encoder Interface.
  96:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c **** 
  97:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****      (#) Activate the TIM peripheral using one of the start functions depending from the feature us
  98:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Time Base : HAL_TIM_Base_Start(), HAL_TIM_Base_Start_DMA(), HAL_TIM_Base_Start_IT()
  99:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Input Capture :  HAL_TIM_IC_Start(), HAL_TIM_IC_Start_DMA(), HAL_TIM_IC_Start_IT()
 100:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Output Compare : HAL_TIM_OC_Start(), HAL_TIM_OC_Start_DMA(), HAL_TIM_OC_Start_IT()
 101:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) PWM generation : HAL_TIM_PWM_Start(), HAL_TIM_PWM_Start_DMA(), HAL_TIM_PWM_Start_IT
 102:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) One-pulse mode output : HAL_TIM_OnePulse_Start(), HAL_TIM_OnePulse_Start_IT()
 103:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****            (++) Encoder mode output : HAL_TIM_Encoder_Start(), HAL_TIM_Encoder_Start_DMA(), HAL_TIM
 104:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c **** 
 105:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****      (#) The DMA Burst is managed with the two following functions:
 106:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim.c ****          HAL_TIM_DMABurst_WriteStart()

 293:driver/Src/EMC2305.c **** /**
 294:driver/Src/EMC2305.c ****  * @brief   Sets the specified fan's PWM driver to open-drain or push-pull
 295:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to set
 296:driver/Src/EMC2305.c ****  * @param   fan Fan to set (1-5)
 297:driver/Src/EMC2305.c ****  * @param   open_drain Set to true for open-drain (only driven low, requires pullup) or false for p
 298:driver/Src/EMC2305.c ****  * @return  OK if successful, ERR otherwise
 299:driver/Src/EMC2305.c ****  */
 300:driver/Src/EMC2305.c **** EMC2305_Status EMC2305_SetPWMOutputMode(EMC2305_HandleTypeDef* chip, EMC2305_Fan fan, bool open_dra
 301:driver/Src/EMC2305.c ****     if (EMC2305_INVALID_FAN(fan)) {
 302:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 303:driver/Src/EMC2305.c ****     }
 304:driver/Src/EMC2305.c **** 
 305:driver/Src/EMC2305.c ****     // Read current value of register (friendly)
 306:driver/Src/EMC2305.c ****     uint8_t val = 0;
 307:driver/Src/EMC2305.c ****     if (EMC2305_ReadReg(chip, EMC2305_REG_PWM_OUTPUT_CONFIG, &val) != EMC2305_OK) {
 308:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 309:driver/Src/EMC2305.c ****     }
 310:driver/Src/EMC2305.c **** 
 311:driver/Src/EMC2305.c ****     if (open_drain == true) {
 312:driver/Src/EMC2305.c ****         // Open-drain output mode
 313:driver/Src/EMC2305.c ****         val &= ~(1 << fan);
 314:driver/Src/EMC2305.c ****     }
 315:driver/Src/EMC2305.c ****     else {
 316:driver/Src/EMC2305.c ****         // Push-pull output mode
 317:driver/Src/EMC2305.c ****         val |= (1 << fan);
 318:driver/Src/EMC2305.c ****     }
 319:driver/Src/EMC2305.c **** 
 320:driver/Src/EMC2305.c ****     // Write back PWM output config
ARM GAS  /tmp/cciWHfbE.s 			page 10


 321:driver/Src/EMC2305.c ****     return EMC2305_WriteReg(chip, EMC2305_REG_PWM_OUTPUT_CONFIG, val);

 194:driver/Src/EMC2305.c **** /**
 195:driver/Src/EMC2305.c ****  * @brief   Sets the base frequency of the specified fan's PWM driver
 196:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to use
 197:driver/Src/EMC2305.c ****  * @param   fan Fan to use (1-5)
 198:driver/Src/EMC2305.c ****  * @param   freq Base frequency as specified in Section 6.10
 199:driver/Src/EMC2305.c ****  * @return  OK if successful, ERR otherwise
 200:driver/Src/EMC2305.c ****  */
 201:driver/Src/EMC2305.c **** EMC2305_Status EMC2305_SetPWMBaseFrequency(EMC2305_HandleTypeDef* chip, EMC2305_Fan fan, EMC2305_PW
 202:driver/Src/EMC2305.c ****     // Check if the user is stupid (lakshay)
 203:driver/Src/EMC2305.c ****     if (EMC2305_INVALID_FAN(fan)) {
 204:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 205:driver/Src/EMC2305.c ****     }
 206:driver/Src/EMC2305.c **** 
ARM GAS  /tmp/cciWHfbE.s 			page 8


 207:driver/Src/EMC2305.c ****     // Determine which register to use
 208:driver/Src/EMC2305.c ****     uint8_t reg;
 209:driver/Src/EMC2305.c ****     if ((fan == EMC2305_FAN4) || (fan == EMC2305_FAN5)) {
 210:driver/Src/EMC2305.c ****         // PWM BaseF45 Register
 211:driver/Src/EMC2305.c ****         reg = EMC2305_REG_PWM_BASEF45;
 212:driver/Src/EMC2305.c ****     }
 213:driver/Src/EMC2305.c ****     else {
 214:driver/Src/EMC2305.c ****         // PWM BaseF123 Register
 215:driver/Src/EMC2305.c ****         reg = EMC2305_REG_PWM_BASEF123;
 216:driver/Src/EMC2305.c ****     }
 217:driver/Src/EMC2305.c **** 
 218:driver/Src/EMC2305.c ****     // Read current value of register (need to be friendly :PPP)
 219:driver/Src/EMC2305.c ****     uint8_t val = 0;
 220:driver/Src/EMC2305.c ****     if (EMC2305_ReadReg(chip, reg, &val) != EMC2305_OK) {
 221:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 222:driver/Src/EMC2305.c ****     }
 223:driver/Src/EMC2305.c **** 
 224:driver/Src/EMC2305.c ****     // Clear and update frequency
 225:driver/Src/EMC2305.c ****     switch (fan)
 226:driver/Src/EMC2305.c ****     {
 227:driver/Src/EMC2305.c ****     case EMC2305_FAN1:
 228:driver/Src/EMC2305.c ****         val &= ~EMC2305_PWM_FAN1_MASK;
 229:driver/Src/EMC2305.c ****         val |= freq << EMC2305_PWM_FAN1_SHIFT;
 230:driver/Src/EMC2305.c ****         break;
 231:driver/Src/EMC2305.c ****     case EMC2305_FAN2:
 232:driver/Src/EMC2305.c ****         val &= ~EMC2305_PWM_FAN2_MASK;
 233:driver/Src/EMC2305.c ****         val |= freq << EMC2305_PWM_FAN2_SHIFT;
 234:driver/Src/EMC2305.c ****         break;
 235:driver/Src/EMC2305.c ****     case EMC2305_FAN3:
 236:driver/Src/EMC2305.c ****         val &= ~EMC2305_PWM_FAN3_MASK;
 237:driver/Src/EMC2305.c ****         val |= freq << EMC2305_PWM_FAN3_SHIFT;
 238:driver/Src/EMC2305.c ****         break;
 239:driver/Src/EMC2305.c ****     case EMC2305_FAN4:
 240:driver/Src/EMC2305.c ****         val &= ~EMC2305_PWM_FAN4_MASK;
 241:driver/Src/EMC2305.c ****         val |= freq << EMC2305_PWM_FAN4_SHIFT;
 242:driver/Src/EMC2305.c ****         break;
 243:driver/Src/EMC2305.c ****     case EMC2305_FAN5:
 244:driver/Src/EMC2305.c ****         val &= ~EMC2305_PWM_FAN5_MASK;
 245:driver/Src/EMC2305.c ****         val |= freq << EMC2305_PWM_FAN5_SHIFT;
 246:driver/Src/EMC2305.c ****         break;
 247:driver/Src/EMC2305.c ****     default:
 248:driver/Src/EMC2305.c ****         // lmfao
 249:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 250:driver/Src/EMC2305.c ****         break;
 251:driver/Src/EMC2305.c ****     }
 252:driver/Src/EMC2305.c **** 
 253:driver/Src/EMC2305.c ****     // Write PWM base frequency
 254:driver/Src/EMC2305.c ****     return EMC2305_WriteReg(chip, reg, val);
 255:driver/Src/EMC2305.c **** }

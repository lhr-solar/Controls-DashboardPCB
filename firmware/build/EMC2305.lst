 154:driver/Src/EMC2305.c **** /**
 155:driver/Src/EMC2305.c ****  * @brief   Software locks all SWL registers. SWL registers are now read-only until power cycle.
 156:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to lock
 157:driver/Src/EMC2305.c ****  * @return  OK if successful, ERR otherwise
 158:driver/Src/EMC2305.c ****  */
 159:driver/Src/EMC2305.c **** EMC2305_Status EMC2305_EnableSWLock(EMC2305_HandleTypeDef* chip) {
 160:driver/Src/EMC2305.c ****     return EMC2305_WriteReg(chip, EMC2305_REG_SW_LOCK, EMC2305_SWL);
 161:driver/Src/EMC2305.c **** }
 162:driver/Src/EMC2305.c **** 
 163:driver/Src/EMC2305.c **** /**
 164:driver/Src/EMC2305.c ****  * @brief   Sets the EMC2305 global configuration register based on provided config
 165:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to configure
 166:driver/Src/EMC2305.c ****  * @param   config Global configuration to use
 167:driver/Src/EMC2305.c ****  * @return  OK if successful, ERR otherwise
 168:driver/Src/EMC2305.c ****  */
 169:driver/Src/EMC2305.c **** EMC2305_Status EMC2305_SetGlobalConfig(EMC2305_HandleTypeDef* chip, EMC2305_Global_Config* config) 
 170:driver/Src/EMC2305.c ****     // Set bits based on config
 171:driver/Src/EMC2305.c ****     uint8_t config_bits = 0;
 172:driver/Src/EMC2305.c ****     if (config->alert_mask) {
 173:driver/Src/EMC2305.c ****         config_bits |= EMC2305_CFG_MASK_ALERT;
 174:driver/Src/EMC2305.c ****     }
 175:driver/Src/EMC2305.c ****     if (config->disable_smbus_timeout) {
 176:driver/Src/EMC2305.c ****         config_bits |= EMC2305_CFG_DIS_TO;
 177:driver/Src/EMC2305.c ****     }
 178:driver/Src/EMC2305.c ****     if (config->watchdog_enable) {

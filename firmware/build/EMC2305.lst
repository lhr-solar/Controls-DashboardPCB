 444:driver/Src/EMC2305.c **** /**
 445:driver/Src/EMC2305.c ****  * @brief   Gets current fan status for all drivers
 446:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to get
 447:driver/Src/EMC2305.c ****  * @return  Fan status for all drivers
 448:driver/Src/EMC2305.c ****  */
 449:driver/Src/EMC2305.c **** EMC2305_Fan_Status EMC2305_GetFanStatus(EMC2305_HandleTypeDef* chip) {
 450:driver/Src/EMC2305.c ****     EMC2305_Fan_Status status = { 0 };
 451:driver/Src/EMC2305.c **** 
 452:driver/Src/EMC2305.c ****     // Read fan status register
 453:driver/Src/EMC2305.c ****     uint8_t val = 0;
 454:driver/Src/EMC2305.c ****     if (EMC2305_ReadReg(chip, EMC2305_REG_FAN_STATUS, &val) != EMC2305_OK) {
 455:driver/Src/EMC2305.c ****         // Error handling is fake :D
 456:driver/Src/EMC2305.c ****         return status;
 457:driver/Src/EMC2305.c ****     }
 458:driver/Src/EMC2305.c **** 
 459:driver/Src/EMC2305.c ****     // Update status values
 460:driver/Src/EMC2305.c ****     status.watchdog_fired = ((val & EMC2305_STAT_WATCH) == EMC2305_STAT_WATCH);
 461:driver/Src/EMC2305.c ****     status.drive_failed = ((val & EMC2305_STAT_DRVFAIL) == EMC2305_STAT_DRVFAIL);
 462:driver/Src/EMC2305.c ****     status.spin_failed = ((val & EMC2305_STAT_FNSPIN) == EMC2305_STAT_FNSPIN);
 463:driver/Src/EMC2305.c ****     status.stalled = ((val & EMC2305_STAT_FNSTL) == EMC2305_STAT_FNSTL);
 464:driver/Src/EMC2305.c **** 
 465:driver/Src/EMC2305.c ****     return status;
 466:driver/Src/EMC2305.c **** }

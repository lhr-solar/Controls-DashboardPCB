 468:driver/Src/EMC2305.c **** // Register Read/Write Functions
 469:driver/Src/EMC2305.c **** 
 470:driver/Src/EMC2305.c **** /**
 471:driver/Src/EMC2305.c ****  * @brief   Reads a byte of data from the specified register
 472:driver/Src/EMC2305.c ****  * @param   chip EMC2305 handle
 473:driver/Src/EMC2305.c ****  * @param   reg Register to read from
 474:driver/Src/EMC2305.c ****  * @param   data Pointer where register data will be stored
 475:driver/Src/EMC2305.c ****  * @return  OK if successful, ERR if message queue is full
 476:driver/Src/EMC2305.c ****  */
 477:driver/Src/EMC2305.c **** EMC2305_Status EMC2305_ReadReg(EMC2305_HandleTypeDef* chip, uint8_t reg, uint8_t* data) {
 478:driver/Src/EMC2305.c ****     // Acquire semaphore from the pool
 479:driver/Src/EMC2305.c ****     int8_t index = prvAcquireFreeSemaphore();
 480:driver/Src/EMC2305.c ****     if (index < 0) {
 481:driver/Src/EMC2305.c ****         // Pool full (Queue likely full too)

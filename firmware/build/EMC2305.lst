 326:driver/Src/EMC2305.c **** /**
 327:driver/Src/EMC2305.c ****  * @brief   Sets the PWM drive of the specified fan directly. Works only with fan speed control (FS
 328:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to set
 329:driver/Src/EMC2305.c ****  * @param   fan Fan to set (1-5)
 330:driver/Src/EMC2305.c ****  * @param   duty_cycle PWM duty cycle percentage (0 to 100)
 331:driver/Src/EMC2305.c ****  * @return  OK if successful, ERR otherwise
 332:driver/Src/EMC2305.c ****  */
 333:driver/Src/EMC2305.c **** EMC2305_Status EMC2305_SetFanPWM(EMC2305_HandleTypeDef* chip, EMC2305_Fan fan, uint8_t duty_cycle) 
 334:driver/Src/EMC2305.c ****     if (EMC2305_INVALID_FAN(fan)) {
 335:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 336:driver/Src/EMC2305.c ****     }
 337:driver/Src/EMC2305.c **** 
 338:driver/Src/EMC2305.c ****     // oops
 339:driver/Src/EMC2305.c ****     if (duty_cycle > 100) {
 340:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 341:driver/Src/EMC2305.c ****     }
 342:driver/Src/EMC2305.c **** 
 343:driver/Src/EMC2305.c ****     // Convert duty cycle percentage drive to register value using Equation 4-1: Drive = (Value/255
 344:driver/Src/EMC2305.c ****     uint8_t val = (duty_cycle * 255) / 100;
 345:driver/Src/EMC2305.c **** 

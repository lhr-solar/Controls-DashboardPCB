 385:driver/Src/EMC2305.c **** // Status & Measurement Functions
 386:driver/Src/EMC2305.c **** 
 387:driver/Src/EMC2305.c **** /**
 388:driver/Src/EMC2305.c ****  * @brief   Gets current fan RPM based on tachometer measurement
 389:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to get
 390:driver/Src/EMC2305.c ****  * @param   fan Fan to get (1-5)
 391:driver/Src/EMC2305.c ****  * @return  Measured fan RPM. UINT16_MAX on error
 392:driver/Src/EMC2305.c ****  */
 393:driver/Src/EMC2305.c **** uint16_t EMC2305_GetFanRPM(EMC2305_HandleTypeDef* chip, EMC2305_Fan fan) {
 394:driver/Src/EMC2305.c ****     if (EMC2305_INVALID_FAN(fan)) {
 395:driver/Src/EMC2305.c ****         return UINT16_MAX;
 396:driver/Src/EMC2305.c ****     }
 397:driver/Src/EMC2305.c **** 
 398:driver/Src/EMC2305.c ****     // Read tachometer reading high and low bytes
 399:driver/Src/EMC2305.c ****     uint8_t high_byte = 0;
 400:driver/Src/EMC2305.c ****     uint8_t low_byte = 0;
 401:driver/Src/EMC2305.c ****     if (EMC2305_ReadReg(chip, EMC2305_FAN_REG_ADDR(fan, EMC2305_REG_FAN1_TACH_READING_H), &high_byt
 402:driver/Src/EMC2305.c ****         return UINT16_MAX;
 403:driver/Src/EMC2305.c ****     }
 404:driver/Src/EMC2305.c ****     if (EMC2305_ReadReg(chip, EMC2305_FAN_REG_ADDR(fan, EMC2305_REG_FAN1_TACH_READING_L), &low_byte
 405:driver/Src/EMC2305.c ****         return UINT16_MAX;
 406:driver/Src/EMC2305.c ****     }
 407:driver/Src/EMC2305.c **** 
 408:driver/Src/EMC2305.c ****     // Combine into tach measurement
 409:driver/Src/EMC2305.c ****     uint16_t tach_reading = ((high_byte << 5) + ((low_byte >> 3) & 0x1F)) & 0x1FFF;
 410:driver/Src/EMC2305.c **** 
 411:driver/Src/EMC2305.c ****     // Divide by zero bad
 412:driver/Src/EMC2305.c ****     if (tach_reading == 0) {
 413:driver/Src/EMC2305.c ****         return UINT16_MAX;
 414:driver/Src/EMC2305.c ****     }
 415:driver/Src/EMC2305.c **** 
 416:driver/Src/EMC2305.c ****     // Convert tachometer counts to RPM
 417:driver/Src/EMC2305.c ****     uint16_t rpm = (EMC2305_TACH_RPM_CONV * EMC2305_TACH_MULT) / tach_reading;
 418:driver/Src/EMC2305.c ****     return rpm;
 419:driver/Src/EMC2305.c **** }
 420:driver/Src/EMC2305.c **** 
 421:driver/Src/EMC2305.c **** /**
 422:driver/Src/EMC2305.c ****  * @brief   Gets current fan driver PWM duty cycle
 423:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to get
 424:driver/Src/EMC2305.c ****  * @param   fan Fan to get (1-5)
 425:driver/Src/EMC2305.c ****  * @return  Driven fan PWM duty cycle (0-100). UINT8_MAX on error
 426:driver/Src/EMC2305.c ****  */
 427:driver/Src/EMC2305.c **** uint8_t EMC2305_GetFanPWM(EMC2305_HandleTypeDef* chip, EMC2305_Fan fan) {
 428:driver/Src/EMC2305.c ****     if (EMC2305_INVALID_FAN(fan)) {
 429:driver/Src/EMC2305.c ****         return UINT8_MAX;
 430:driver/Src/EMC2305.c ****     }
 431:driver/Src/EMC2305.c **** 
 432:driver/Src/EMC2305.c ****     // Read PWM from drive register
 433:driver/Src/EMC2305.c ****     uint8_t val = 0;
 434:driver/Src/EMC2305.c ****     if (EMC2305_ReadReg(chip, EMC2305_FAN_REG_ADDR(fan, EMC2305_REG_FAN1_SETTING), &val) != EMC2305
ARM GAS  /tmp/cciWHfbE.s 			page 12


 435:driver/Src/EMC2305.c ****         return UINT8_MAX;
 436:driver/Src/EMC2305.c ****     }
 437:driver/Src/EMC2305.c **** 
 438:driver/Src/EMC2305.c ****     // Convert register value to duty cycle percentage
 439:driver/Src/EMC2305.c ****     uint8_t pwm = (val * 100) / 255;
 440:driver/Src/EMC2305.c **** 
 441:driver/Src/EMC2305.c ****     return pwm;
 442:driver/Src/EMC2305.c **** }

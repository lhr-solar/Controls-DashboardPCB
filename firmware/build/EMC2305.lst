 350:driver/Src/EMC2305.c **** /**
 351:driver/Src/EMC2305.c ****  * @brief   Sets the RPM target for the control algorithm. Works only with fan speed control (FSC) 
 352:driver/Src/EMC2305.c ****  * @param   chip EMC2305 to set
 353:driver/Src/EMC2305.c ****  * @param   fan Fan to set (1-5)
 354:driver/Src/EMC2305.c ****  * @param   rpm_target RPM target to set (500 to 16k)
 355:driver/Src/EMC2305.c ****  * @return  OK if successful, ERR otherwise
 356:driver/Src/EMC2305.c ****  */
 357:driver/Src/EMC2305.c **** EMC2305_Status EMC2305_SetFanRPM(EMC2305_HandleTypeDef* chip, EMC2305_Fan fan, uint16_t rpm_target)
 358:driver/Src/EMC2305.c ****     if (EMC2305_INVALID_FAN(fan)) {
 359:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 360:driver/Src/EMC2305.c ****     }
 361:driver/Src/EMC2305.c **** 
 362:driver/Src/EMC2305.c ****     // idiot check
 363:driver/Src/EMC2305.c ****     if ((rpm_target < EMC2305_MIN_RPM) || (rpm_target > EMC2305_MAX_RPM)) {
 364:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 365:driver/Src/EMC2305.c ****     }
 366:driver/Src/EMC2305.c **** 
 367:driver/Src/EMC2305.c ****     // Convert RPM target to tachometer counts
 368:driver/Src/EMC2305.c ****     // DO NOT CHANGE THIS NUMBER OR CALCULATION YOU WILL REGRET
 369:driver/Src/EMC2305.c ****     // WARNING: assuming 2 poles, 32.768 measurement freq, 5 edges, multiplier = 1
 370:driver/Src/EMC2305.c ****     // This is the default configuration. Reference app note (https://ww1.microchip.com/downloads/e
 371:driver/Src/EMC2305.c ****     uint16_t tach_target = (EMC2305_TACH_RPM_CONV * EMC2305_TACH_MULT) / rpm_target;
 372:driver/Src/EMC2305.c **** 
 373:driver/Src/EMC2305.c ****     // Split into high and low bytes
 374:driver/Src/EMC2305.c ****     tach_target &= 0x1FFF; // ensure 13-bit range
 375:driver/Src/EMC2305.c ****     uint8_t high_byte = (tach_target >> 5) & 0xFF;     // bits [12:5]
 376:driver/Src/EMC2305.c ****     uint8_t low_byte = (tach_target & 0x1F) << 3;      // bits [4:0]
 377:driver/Src/EMC2305.c **** 
ARM GAS  /tmp/cciWHfbE.s 			page 11


 378:driver/Src/EMC2305.c ****     // Must write low byte first, value is saved once high byte is written
 379:driver/Src/EMC2305.c ****     if (EMC2305_WriteReg(chip, EMC2305_FAN_REG_ADDR(fan, EMC2305_REG_FAN1_TACH_TARGET_L), low_byte)
 380:driver/Src/EMC2305.c ****         return EMC2305_ERR;
 381:driver/Src/EMC2305.c ****     }
 382:driver/Src/EMC2305.c ****     return EMC2305_WriteReg(chip, EMC2305_FAN_REG_ADDR(fan, EMC2305_REG_FAN1_TACH_TARGET_H), high_b
 383:driver/Src/EMC2305.c **** }

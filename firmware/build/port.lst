 864:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c **** 
 865:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****             /* The following assertion will fail if a service routine (ISR) for
 866:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * an interrupt that has been assigned a priority above
 867:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * configMAX_SYSCALL_INTERRUPT_PRIORITY calls an ISR safe FreeRTOS API
 868:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * function.  ISR safe FreeRTOS API functions must *only* be called
 869:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * from interrupts that have been assigned a priority at or below
 870:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * configMAX_SYSCALL_INTERRUPT_PRIORITY.
 871:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              *
 872:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * Numerically low interrupt priority numbers represent logically high
 873:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * interrupt priorities, therefore the priority of the interrupt must
 874:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * be set to a value equal to or numerically *higher* than
 875:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * configMAX_SYSCALL_INTERRUPT_PRIORITY.
 876:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              *
 877:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * Interrupts that  use the FreeRTOS API must not be left at their
 878:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * default priority of  zero as that is the highest possible priority,
 879:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * which is guaranteed to be above configMAX_SYSCALL_INTERRUPT_PRIORITY,
 880:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * and  therefore also guaranteed to be invalid.
 881:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              *
 882:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * FreeRTOS maintains separate thread and ISR API functions to ensure
 883:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * interrupt entry is as fast and simple as possible.
 884:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              *
 885:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * The following links provide detailed information:
 886:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * https://www.FreeRTOS.org/RTOS-Cortex-M3-M4.html
 887:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****              * https://www.freertos.org/Why-FreeRTOS/FAQs */
 888:middleware/FreeRTOS-Kernel/portable/GCC/ARM_CM4F/port.c ****             configASSERT( ucCurrentPriority >= ucMaxSysCallPriority );

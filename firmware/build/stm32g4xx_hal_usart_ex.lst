 179:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   assert_param(IS_UART_SPI_SLAVE_INSTANCE(husart->Instance));
 180:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c **** 

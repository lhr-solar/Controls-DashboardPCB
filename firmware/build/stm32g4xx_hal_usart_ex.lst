 205:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c **** 
 206:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   husart->State = HAL_USART_STATE_READY;
 207:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c **** 
 208:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   /* Enable USART */
 209:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   __HAL_USART_ENABLE(husart);
 210:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c **** 

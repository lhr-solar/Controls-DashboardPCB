 187:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   tmpcr1 = READ_REG(husart->Instance->CR1);
 188:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c **** 
 189:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   /* Disable USART */
 190:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   __HAL_USART_DISABLE(husart);

 192:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   /* In SPI slave mode mode, the following bits must be kept cleared:
 193:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   - LINEN and CLKEN bit in the USART_CR2 register
 194:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   - HDSEL, SCEN and IREN bits in the USART_CR3 register.*/
 195:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   CLEAR_BIT(husart->Instance->CR2, (USART_CR2_LINEN | USART_CR2_CLKEN));
 196:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c ****   CLEAR_BIT(husart->Instance->CR3, (USART_CR3_SCEN | USART_CR3_HDSEL | USART_CR3_IREN));

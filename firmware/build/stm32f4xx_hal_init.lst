 716:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****     }
 717:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****     else if (val < min)
 718:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****     {

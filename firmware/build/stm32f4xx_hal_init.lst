 720:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****     }
 721:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****   }
 722:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****   return val;

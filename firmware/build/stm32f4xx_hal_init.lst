 703:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****   \param [in]  value  Value to be saturated
 704:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****   \param [in]    sat  Bit position to saturate to (1..32)
 705:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****   \return             Saturated value
 706:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****  */
 707:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE int32_t __SSAT(int32_t val, uint32_t sat)
 708:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h **** {
 709:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****   if ((sat >= 1U) && (sat <= 32U))
 710:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****   {
 711:stm/stm32f4xx/CMSIS/Include/cmsis_gcc.h ****     const int32_t max = (int32_t)((1U << (sat - 1U)) - 1U);

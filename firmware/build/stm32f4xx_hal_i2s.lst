 789:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****  ===============================================================================
 790:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****                       ##### IO operation functions #####
 791:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****  ===============================================================================
 792:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     [..]
 793:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     This subsection provides a set of functions allowing to manage the I2S data
 794:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     transfers.
 795:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c **** 
 796:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     (#) There are two modes of transfer:
 797:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****        (++) Blocking mode : The communication is performed in the polling mode.
 798:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****             The status of all data processing is returned by the same function
 799:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****             after finishing transfer.
 800:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****        (++) No-Blocking mode : The communication is performed using Interrupts
 801:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****             or DMA. These functions return the status of the transfer startup.
 802:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****             The end of the data processing will be indicated through the
 803:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****             dedicated I2S IRQ when using Interrupt mode or the DMA IRQ when
 804:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****             using DMA mode.
 805:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c **** 
 806:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     (#) Blocking mode functions are :
 807:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_Transmit()
 808:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_Receive()
 809:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c **** 
 810:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     (#) No-Blocking mode functions with Interrupt are :
 811:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_Transmit_IT()
 812:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_Receive_IT()
 813:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c **** 
 814:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     (#) No-Blocking mode functions with DMA are :
 815:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_Transmit_DMA()
 816:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_Receive_DMA()
 817:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c **** 
 818:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****     (#) A set of Transfer Complete Callbacks are provided in non Blocking mode:
 819:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_TxCpltCallback()
 820:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_RxCpltCallback()
 821:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c ****         (++) HAL_I2S_ErrorCallback()
 822:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c **** 
 823:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2s.c **** @endverbatim

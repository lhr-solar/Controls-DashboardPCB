 379:bsp/Src/CAN.c ****     HAL_NVIC_SetPriority(txIRQ, 5, 0);
 380:bsp/Src/CAN.c ****     HAL_NVIC_EnableIRQ(txIRQ);
 381:bsp/Src/CAN.c ****     HAL_NVIC_SetPriority(rxIRQ, 5, 0);
 382:bsp/Src/CAN.c ****     HAL_NVIC_EnableIRQ(rxIRQ);

5302:middleware/FreeRTOS-Kernel/tasks.c **** 
5303:middleware/FreeRTOS-Kernel/tasks.c ****     /* THIS FUNCTION MUST BE CALLED WITH THE
5304:middleware/FreeRTOS-Kernel/tasks.c ****      * SCHEDULER SUSPENDED AND THE QUEUE BEING ACCESSED LOCKED. */
5305:middleware/FreeRTOS-Kernel/tasks.c **** 
5306:middleware/FreeRTOS-Kernel/tasks.c ****     /* Place the event list item of the TCB in the appropriate event list.
5307:middleware/FreeRTOS-Kernel/tasks.c ****      * This is placed in the list in priority order so the highest priority task
5308:middleware/FreeRTOS-Kernel/tasks.c ****      * is the first to be woken by the event.
5309:middleware/FreeRTOS-Kernel/tasks.c ****      *
5310:middleware/FreeRTOS-Kernel/tasks.c ****      * Note: Lists are sorted in ascending order by ListItem_t.xItemValue.
5311:middleware/FreeRTOS-Kernel/tasks.c ****      * Normally, the xItemValue of a TCB's ListItem_t members is:
5312:middleware/FreeRTOS-Kernel/tasks.c ****      *      xItemValue = ( configMAX_PRIORITIES - uxPriority )
5313:middleware/FreeRTOS-Kernel/tasks.c ****      * Therefore, the event list is sorted in descending priority order.
5314:middleware/FreeRTOS-Kernel/tasks.c ****      *
5315:middleware/FreeRTOS-Kernel/tasks.c ****      * The queue that contains the event list is locked, preventing
5316:middleware/FreeRTOS-Kernel/tasks.c ****      * simultaneous access from interrupts. */
5317:middleware/FreeRTOS-Kernel/tasks.c ****     vListInsert( pxEventList, &( pxCurrentTCB->xEventListItem ) );
5318:middleware/FreeRTOS-Kernel/tasks.c **** 
5319:middleware/FreeRTOS-Kernel/tasks.c ****     prvAddCurrentTaskToDelayedList( xTicksToWait, pdTRUE );
5320:middleware/FreeRTOS-Kernel/tasks.c **** 
5321:middleware/FreeRTOS-Kernel/tasks.c ****     traceRETURN_vTaskPlaceOnEventList();
5322:middleware/FreeRTOS-Kernel/tasks.c **** }

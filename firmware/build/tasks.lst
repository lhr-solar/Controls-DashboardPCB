 355:middleware/FreeRTOS-Kernel/tasks.c ****         }                                                                                    \
 356:middleware/FreeRTOS-Kernel/tasks.c ****         else                                                                                 \
 357:middleware/FreeRTOS-Kernel/tasks.c ****         {                                                                                    \
 358:middleware/FreeRTOS-Kernel/tasks.c ****             /* Request other core to yield if it is not requested before. */                 \

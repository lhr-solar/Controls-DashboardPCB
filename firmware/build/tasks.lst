3836:middleware/FreeRTOS-Kernel/tasks.c **** 
3837:middleware/FreeRTOS-Kernel/tasks.c **** void vTaskSuspendAll( void )
3838:middleware/FreeRTOS-Kernel/tasks.c **** {
3839:middleware/FreeRTOS-Kernel/tasks.c ****     traceENTER_vTaskSuspendAll();
3840:middleware/FreeRTOS-Kernel/tasks.c **** 
3841:middleware/FreeRTOS-Kernel/tasks.c ****     #if ( configNUMBER_OF_CORES == 1 )
3842:middleware/FreeRTOS-Kernel/tasks.c ****     {
3843:middleware/FreeRTOS-Kernel/tasks.c ****         /* A critical section is not required as the variable is of type
3844:middleware/FreeRTOS-Kernel/tasks.c ****          * BaseType_t. Each task maintains its own context, and a context switch
3845:middleware/FreeRTOS-Kernel/tasks.c ****          * cannot occur if the variable is non zero. So, as long as the writing
3846:middleware/FreeRTOS-Kernel/tasks.c ****          * from the register back into the memory is atomic, it is not a
3847:middleware/FreeRTOS-Kernel/tasks.c ****          * problem.
3848:middleware/FreeRTOS-Kernel/tasks.c ****          *
3849:middleware/FreeRTOS-Kernel/tasks.c ****          * Consider the following scenario, which starts with
3850:middleware/FreeRTOS-Kernel/tasks.c ****          * uxSchedulerSuspended at zero.
3851:middleware/FreeRTOS-Kernel/tasks.c ****          *
3852:middleware/FreeRTOS-Kernel/tasks.c ****          * 1. load uxSchedulerSuspended into register.
3853:middleware/FreeRTOS-Kernel/tasks.c ****          * 2. Now a context switch causes another task to run, and the other
3854:middleware/FreeRTOS-Kernel/tasks.c ****          *    task uses the same variable. The other task will see the variable
3855:middleware/FreeRTOS-Kernel/tasks.c ****          *    as zero because the variable has not yet been updated by the
3856:middleware/FreeRTOS-Kernel/tasks.c ****          *    original task. Eventually the original task runs again. **That can
3857:middleware/FreeRTOS-Kernel/tasks.c ****          *    only happen when uxSchedulerSuspended is once again zero**. When
3858:middleware/FreeRTOS-Kernel/tasks.c ****          *    the original task runs again, the contents of the CPU registers
3859:middleware/FreeRTOS-Kernel/tasks.c ****          *    are restored to exactly how they were when it was switched out -
3860:middleware/FreeRTOS-Kernel/tasks.c ****          *    therefore the value it read into the register still matches the
3861:middleware/FreeRTOS-Kernel/tasks.c ****          *    value of the uxSchedulerSuspended variable.
3862:middleware/FreeRTOS-Kernel/tasks.c ****          *
3863:middleware/FreeRTOS-Kernel/tasks.c ****          * 3. increment register.
3864:middleware/FreeRTOS-Kernel/tasks.c ****          * 4. store register into uxSchedulerSuspended. The value restored to
3865:middleware/FreeRTOS-Kernel/tasks.c ****          *    uxSchedulerSuspended will be the correct value of 1, even though
3866:middleware/FreeRTOS-Kernel/tasks.c ****          *    the variable was used by other tasks in the mean time.
3867:middleware/FreeRTOS-Kernel/tasks.c ****          */
3868:middleware/FreeRTOS-Kernel/tasks.c **** 
3869:middleware/FreeRTOS-Kernel/tasks.c ****         /* portSOFTWARE_BARRIER() is only implemented for emulated/simulated ports that
3870:middleware/FreeRTOS-Kernel/tasks.c ****          * do not otherwise exhibit real time behaviour. */
3871:middleware/FreeRTOS-Kernel/tasks.c ****         portSOFTWARE_BARRIER();
3872:middleware/FreeRTOS-Kernel/tasks.c **** 
3873:middleware/FreeRTOS-Kernel/tasks.c ****         /* The scheduler is suspended if uxSchedulerSuspended is non-zero.  An increment
3874:middleware/FreeRTOS-Kernel/tasks.c ****          * is used to allow calls to vTaskSuspendAll() to nest. */
3875:middleware/FreeRTOS-Kernel/tasks.c ****         uxSchedulerSuspended = ( UBaseType_t ) ( uxSchedulerSuspended + 1U );
3876:middleware/FreeRTOS-Kernel/tasks.c **** 
3877:middleware/FreeRTOS-Kernel/tasks.c ****         /* Enforces ordering for ports and optimised compilers that may otherwise place
3878:middleware/FreeRTOS-Kernel/tasks.c ****          * the above increment elsewhere. */
3879:middleware/FreeRTOS-Kernel/tasks.c ****         portMEMORY_BARRIER();
3880:middleware/FreeRTOS-Kernel/tasks.c ****     }
3881:middleware/FreeRTOS-Kernel/tasks.c ****     #else /* #if ( configNUMBER_OF_CORES == 1 ) */
3882:middleware/FreeRTOS-Kernel/tasks.c ****     {
3883:middleware/FreeRTOS-Kernel/tasks.c ****         UBaseType_t ulState;

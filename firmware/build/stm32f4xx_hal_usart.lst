 659:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   [..]
 660:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     This subsection provides a set of functions allowing to manage the USART synchronous
 661:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     data transfers.
 662:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 663:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   [..]
 664:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     The USART supports master mode only: it cannot receive or send data related to an input
 665:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     clock (SCLK is always an output).
 666:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 667:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) There are two modes of transfer:
 668:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) Blocking mode: The communication is performed in polling mode.
 669:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The HAL status of all data processing is returned by the same function
 670:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              after finishing transfer.
 671:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) No-Blocking mode: The communication is performed using Interrupts
 672:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              or DMA, These API's return the HAL status.
 673:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The end of the data processing will be indicated through the
 674:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              dedicated USART IRQ when using Interrupt mode or the DMA IRQ when
 675:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              using DMA mode.
 676:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The HAL_USART_TxCpltCallback(), HAL_USART_RxCpltCallback() and HAL_USART_TxRxCpltCallb
 677:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****               user callbacks
 678:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              will be executed respectively at the end of the transmit or Receive process
 679:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The HAL_USART_ErrorCallback() user callback will be executed when a communication
 680:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              error is detected
 681:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 682:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Blocking mode APIs are :
 683:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Transmit() in simplex mode
 684:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Receive() in full duplex receive only
 685:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TransmitReceive() in full duplex mode
 686:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 687:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Non Blocking mode APIs with Interrupt are :
 688:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Transmit_IT()in simplex mode
 689:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Receive_IT() in full duplex receive only
 690:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TransmitReceive_IT() in full duplex mode
 691:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_IRQHandler()
 692:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 693:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Non Blocking mode functions with DMA are :
 694:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Transmit_DMA()in simplex mode
 695:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Receive_DMA() in full duplex receive only
 696:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TransmitReceive_DMA() in full duplex mode
 697:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_DMAPause()
 698:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_DMAResume()
 699:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_DMAStop()
 700:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 701:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) A set of Transfer Complete Callbacks are provided in non Blocking mode:
 702:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TxHalfCpltCallback()
 703:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TxCpltCallback()
 704:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_RxHalfCpltCallback()
 705:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_RxCpltCallback()
 706:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_ErrorCallback()
 707:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TxRxCpltCallback()
 708:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 709:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Non-Blocking mode transfers could be aborted using Abort API's :
 710:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Abort()
 711:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Abort_IT()
 712:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 713:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) For Abort services based on interrupts (HAL_USART_Abort_IT), a Abort Complete Callbacks is 
 714:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_AbortCpltCallback()
ARM GAS  /tmp/ccKOS9Bn.s 			page 14


 715:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 716:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) In Non-Blocking mode transfers, possible errors are split into 2 categories.
 717:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         Errors are handled as follows :
 718:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) Error is considered as Recoverable and non blocking : Transfer could go till end, but 
 719:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              to be evaluated by user : this concerns Frame Error, Parity Error or Noise Error in In
 720:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              Received character is then retrieved and stored in Rx buffer, Error code is set to all
 721:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              and HAL_USART_ErrorCallback() user callback is executed. Transfer is kept ongoing on U
 722:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              If user wants to abort it, Abort services should be called by user.
 723:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) Error is considered as Blocking : Transfer could not be completed properly and is abor
 724:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              This concerns Overrun Error In Interrupt mode reception and all errors in DMA mode.
 725:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              Error code is set to allow user to identify error type, and HAL_USART_ErrorCallback() 
 726:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 727:stm/stm32f4xx/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** @endverbatim

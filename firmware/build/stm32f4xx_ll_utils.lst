 268:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   * @brief  Enable Under Drive Mode
 269:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   * @rmtoll CR    UDEN       LL_PWR_EnableUnderDriveMode
 270:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   * @note  This mode is enabled only with STOP low power mode.
 271:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   *        In this mode, the 1.2V domain is preserved in reduced leakage mode. This 
 272:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   *        mode is only available when the main Regulator or the low power Regulator 
 273:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   *        is in low voltage mode.      
 274:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   * @note  If the Under-drive mode was enabled, it is automatically disabled after 
 275:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   *        exiting Stop mode. 
 276:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   *        When the voltage Regulator operates in Under-drive mode, an additional  
 277:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   *        startup delay is induced when waking up from Stop mode.
 278:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   * @retval None
 279:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h ****   */
 280:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h **** __STATIC_INLINE void LL_PWR_EnableUnderDriveMode(void)
 281:stm/stm32f4xx/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_pwr.h **** {

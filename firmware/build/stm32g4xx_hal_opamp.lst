  11:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_opamp.c ****   *           + Peripheral State functions
  12:stm/stm32g4xx/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_opamp.c ****   *
